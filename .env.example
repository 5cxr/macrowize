# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Required. Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional but recommended. Free, unlimited:
# https://fdc.nal.usda.gov/api-key-signup.html
# Without it the shared DEMO_KEY is used, which is rate limited to ~30/hour.
USDA_API_KEY=

# Provider overrides. Defaults to google/gemini-2.5-flash.
# MACROWIZE_LLM_PROVIDER=groq
# MACROWIZE_LLM_MODEL=gemini-2.0-flash
