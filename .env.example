# macrowize configuration. This file is gitignored -- never commit real keys.
#
# PROVIDER: Gemini is the default. To switch, uncomment ONE block below,
# then RESTART streamlit (the provider is read once at import).

# --- Groq: hosted, very fast, free tier -------------------------------------
# MACROWIZE_LLM_PROVIDER=groq

# --- Ollama: fully local, no key, no quota ----------------------------------
# Needs `ollama serve` running and `ollama pull llama3.2:3b` done once.
# MACROWIZE_LLM_PROVIDER=ollama

# Optional: override the model for whichever provider is active.
# Defaults are gemini-3.6-flash / llama-3.3-70b-versatile / llama3.2:3b
# MACROWIZE_LLM_MODEL=gemini-3.5-flash

# --- Keys -------------------------------------------------------------------
# Gemini (default provider): https://aistudio.google.com/apikey
# Free tier is 20 requests/day PER MODEL.
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# USDA food database: https://fdc.nal.usda.gov/api-key-signup.html
# Without this a shared demo key is used, which rate-limits fast.
USDA_API_KEY=
